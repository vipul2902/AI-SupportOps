# Production-style compose settings. Copy to .env.prod (git-ignored) and replace every value.
# Generate secrets with: openssl rand -base64 48

POSTGRES_DB=aisupportops
POSTGRES_USER=aisupportops
POSTGRES_PASSWORD=replace-with-a-long-random-password
REDIS_PASSWORD=replace-with-a-long-random-password
JWT_SIGNING_KEY=replace-with-output-of-openssl-rand-base64-48

# OpenAI for real answers; Fake only for a keyless demo.
AI_PROVIDER=OpenAI
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

WEB_PORT=80
IMAGE_TAG=local

# Optional: OTLP endpoint for traces/metrics/logs (e.g. an OpenTelemetry Collector).
OTEL_EXPORTER_OTLP_ENDPOINT=
