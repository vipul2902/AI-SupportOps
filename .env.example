# Copy to .env and fill in. .env is git-ignored — never commit real values.

# --- PostgreSQL (docker compose) ---
POSTGRES_DB=aisupportops
POSTGRES_USER=aisupportops
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# --- Redis (docker compose) ---
REDIS_PORT=6379

# --- API container ---
API_PORT=8080

# --- Auth ---
# HMAC key for signing JWTs. At least 32 bytes. Generate with: openssl rand -base64 48
JWT_SIGNING_KEY=replace-with-output-of-openssl-rand-base64-48

# --- AI provider ---
# Fake = deterministic offline embeddings (no key, no cost). OpenAI = real model, needs a key.
AI_PROVIDER=Fake
OPENAI_API_KEY=
